# Copy to `.env` and fill in real values. Validated at startup by
# src/config/env.validation.ts — a missing or malformed value aborts boot.

# --- Runtime ---
# development | production | test (default: development)
NODE_ENV="development"
# HTTP port (default: 3000)
PORT="3000"

# --- Database (PostgreSQL) ---
# Runtime connection: the NON-SUPERUSER app role, so RLS is enforced.
DATABASE_URL="postgresql://hotelcrm_app:CHANGE_ME@localhost:5432/hotel_crm_dev?schema=public"
# Migration connection: the superuser role (DDL). Used by the Prisma CLI (directUrl).
DIRECT_DATABASE_URL="postgresql://hotelcrm:CHANGE_ME@localhost:5432/hotel_crm_dev?schema=public"

# --- Auth ---
# Signs JWT access tokens. MUST be at least 16 characters; use a long random value.
JWT_SECRET="change-me-to-a-long-random-secret"
# Access token lifetime (e.g. 24h, 30m, 7d). Default: 24h
JWT_EXPIRES_IN="24h"
# Signs JWT refresh tokens. MUST differ from JWT_SECRET and be at least 16 characters.
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-secret"
# Refresh token lifetime. Default: 30d
JWT_REFRESH_EXPIRES_IN="30d"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# Brute-force lockout: failed logins tolerated per tenant+email+IP before the
# account is locked, and how long that lock lasts (seconds).
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_SECONDS="900"
