# Test environment. Points at a SEPARATE database (hotel_crm_test) on the local /
# CI Postgres, so tests never touch dev data. Provisioned automatically by
# test/setup/global-setup.ts (create DB → migrate → app-role grants).
NODE_ENV="test"
PORT="3001"

# Runtime (app role, RLS-enforced) and migration (superuser) connections — same
# two-role model as the app, but against hotel_crm_test.
DATABASE_URL="postgresql://hotelcrm_app:hotelcrm_app_dev_2026@localhost:5432/hotel_crm_test?schema=public"
DIRECT_DATABASE_URL="postgresql://hotelcrm:hotelcrm_dev_2026@localhost:5432/hotel_crm_test?schema=public"

JWT_SECRET="test-insecure-secret-at-least-16-chars"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="test-insecure-refresh-secret-16-chars"
JWT_REFRESH_EXPIRES_IN="30d"
REDIS_URL="redis://localhost:6379"
